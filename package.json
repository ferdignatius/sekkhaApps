{
  "name": "sekkha-apps",
  "version": "1.0.0",
  "private": true,
  "description": "Sekkha Community Apps Monorepo",
  "workspaces": [
    "sekkha-api",
    "sekkha-frontend"
  ],
  "scripts": {
    "dev:api": "npm --prefix sekkha-api run dev",
    "dev:web": "npm --prefix sekkha-frontend run dev",
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "build:api": "npm --prefix sekkha-api run build",
    "build:web": "npm --prefix sekkha-frontend run build",
    "build": "npm run build:api && npm run build:web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
