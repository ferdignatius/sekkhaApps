{
  "name": "sekkha-apps",
  "version": "1.2.0",
  "private": true,
  "description": "Sekkha Community Apps Monorepo",
  "workspaces": [
    "sekkha-api",
    "sekkha-frontend"
  ],
  "scripts": {
    "dev:api": "bun --filter sekkha-api dev",
    "dev:web": "bun --filter sekkha-frontend dev",
    "dev": "bun --filter \"*\" dev",
    "build:api": "bun --filter sekkha-api build",
    "build:web": "bun --filter sekkha-frontend build",
    "build": "bun --filter \"*\" build",
    "db:migrate": "bun --filter sekkha-api db:migrate",
    "db:migrate:deploy": "bun --filter sekkha-api db:migrate:deploy",
    "db:migrate:status": "bun --filter sekkha-api db:migrate:status",
    "db:generate": "bun --filter sekkha-api db:generate",
    "db:seed": "bun --filter sekkha-api db:seed",
    "docker:build": "docker buildx build --platform linux/amd64 -t ferdignatius/sekkha-api:latest -f sekkha-api/Dockerfile --push sekkha-api",
    "release": "bun scripts/release.mjs"
  },
  "overrides": {
    "qs": ">=6.16.1",
    "seroval": ">=1.8.1",
    "@vitest/mocker": "^4.1.12",
    "nodemailer": "^10.5.0",
    "compression": "^1.8.2"
  }
}
