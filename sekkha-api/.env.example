# ==========================================
# Database (PostgreSQL)
# ==========================================
# Untuk Local Dev:
# DATABASE_URL="postgresql://sekkha:sekkha_secret@localhost:5432/sekkha_db?schema=public"
#
# Untuk Docker di VPS (Hubungkan ke existing container PostgreSQL):
# Ganti <USER>, <PASSWORD>, dan <NAMA_CONTAINER_POSTGRES> sesuai container yang sudah ada di VPS:
DATABASE_URL="postgresql://postgres:password@postgres-container-name:5432/sekkha_db?schema=public"

# ==========================================
# Redis Cache & Token Blacklist
# ==========================================
# Untuk Local Dev:
# REDIS_URL="redis://localhost:6379"
#
# Untuk Docker di VPS (Hubungkan ke existing container Redis):
# Ganti <NAMA_CONTAINER_REDIS> sesuai container yang sudah ada di VPS:
REDIS_URL="redis://redis-container-name:6379"

# ==========================================
# JWT Authentication & Security
# ==========================================
# Wajib diubah di production (minimal 32 karakter acak)
JWT_SECRET="ganti-dengan-secret-acak-minimal-32-karakter-di-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Tier 2 Field-Level Encryption & Blind Indexing (64-character hex strings = 32 bytes)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
BLIND_INDEX_KEY="abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"

# ==========================================
# Server & Environment
# ==========================================
PORT=4000
NODE_ENV=production

# ==========================================
# CORS & Frontend URLs
# ==========================================
# Daftarkan domain frontend production secara eksplisit (pisahkan dengan koma jika lebih dari 1)
CORS_ORIGIN="https://sekkha.domainanda.com,http://localhost:3000"
FRONTEND_URL="https://sekkha.domainanda.com"

# ==========================================
# Email Settings (Gmail SMTP)
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="Sekkha Apps <noreply@sekkha.com>"

# ==========================================
# Akun Master / Dummy untuk Seed Awal
# ==========================================
DUMMY_UMAT_EMAIL="umat@sekkha.com"
DUMMY_UMAT_PASSWORD="password123"
DUMMY_AKTIVIS_EMAIL="aktivis@sekkha.com"
DUMMY_AKTIVIS_PASSWORD="password123"
DUMMY_PENGURUS_EMAIL="pengurus@sekkha.com"
DUMMY_PENGURUS_PASSWORD="password123"
DUMMY_ADMIN_EMAIL="admin@sekkha.com"
DUMMY_ADMIN_PASSWORD="password123"

