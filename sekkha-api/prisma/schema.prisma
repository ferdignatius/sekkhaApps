generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  member
  activist
  organizer
  admin
}

enum EventStatus {
  draft
  scheduled
  active
  closed
  cancelled
}

enum EventVisibility {
  all
  member
  activist
  organizer
}

enum AttendanceMethod {
  qr
  manual
}

enum PointTransactionType {
  attendance
  manual
  reward
  system
}

// ─── Core Identity & Authentication (Lean Table) ─────────────────────────────

model User {
  id                    String    @id @default(cuid())
  userNumber            BigInt?   @unique @map("user_number")
  username              String?   @unique @map("username")
  email                 String?   @map("email") // Tier 2: AES-256-GCM ciphertext
  emailBindex           String?   @unique @map("email_bindex") // Tier 2: HMAC-SHA256 Blind Index for O(1) lookup & unique constraint
  emailVerifiedAt       DateTime? @map("email_verified_at")
  password              String?
  role                  Role      @default(member)
  isClaimed             Boolean   @default(true) @map("is_claimed")
  onboardingCompleted   Boolean   @default(false) @map("onboarding_completed")
  claimedAt             DateTime? @map("claimed_at")
  claimedByUserId       String?   @map("claimed_by_user_id")
  claimPin              String?   @map("claim_pin") // Tier 1: One-way bcrypt hash (12 rounds) — never exposed via API
  claimPinExpiresAt     DateTime? @map("claim_pin_expires_at")
  failedClaimAttempts   Int       @default(0) @map("failed_claim_attempts")
  passwordChangedByUser Boolean   @default(false) @map("password_changed_by_user")
  passwordChangedAt     DateTime? @map("password_changed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // 1:1 Normalized Relations
  profile UserProfile?
  stats   UserStats?

  // Relations
  attendances            Attendance[]
  pointTransactions      PointTransaction[]
  submittedSchools       School[]           @relation("SchoolRequester")
  reviewedSchools        School[]           @relation("SchoolReviewer")
  claimedByUser          User?              @relation("UserClaimLink", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  claimedUsers           User[]             @relation("UserClaimLink")

  @@index([role])
  @@index([isClaimed])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

// ─── User Profile (Personal & Academic Data) ─────────────────────────────────

model UserProfile {
  userId     String   @id @map("user_id")
  name       String
  phone      String?  @map("phone") // Tier 2: AES-256-GCM ciphertext
  schoolId   String?  @map("school_id")
  classGrade String?  @map("class_grade") // Tier 2: AES-256-GCM ciphertext
  birthDate  String?  @map("birth_date") // Tier 2: AES-256-GCM ciphertext of ISO date string
  gender     String?  @map("gender") // Tier 2: AES-256-GCM ciphertext ("pria" | "wanita")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([name])
  @@map("user_profiles")
}

// ─── User Stats (Gamification & Engagement Counters) ─────────────────────────

model UserStats {
  userId            String    @id @map("user_id")
  points            Int       @default(0)
  consecutiveMissed Int       @default(0) @map("consecutive_missed")
  lastActivityAt    DateTime? @map("last_activity_at")
  totalAttendances  Int       @default(0) @map("total_attendances")
  currentStreak     Int       @default(0) @map("current_streak")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([points(sort: Desc)])
  @@index([consecutiveMissed])
  @@map("user_stats")
}

// ─── Master Data: Schools ───────────────────────────────────────────────────

enum SchoolStatus {
  pending
  approved
  rejected
}

model School {
  id          String       @id @default(cuid())
  name        String       @unique
  type        String?      // "SMP" | "SMA" | "SMK" | "Universitas" | "Umum"
  status      SchoolStatus @default(approved)
  isActive    Boolean      @default(true) @map("is_active")
  requestedBy String?      @map("requested_by")
  reviewedBy  String?      @map("reviewed_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  profiles    UserProfile[]
  requester   User?        @relation("SchoolRequester", fields: [requestedBy], references: [id], onDelete: SetNull)
  reviewer    User?        @relation("SchoolReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("schools")
}

// ─── Master Data: Event Types ────────────────────────────────────────────────

model EventType {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  description String?
  defaultPointReward Int @default(0) @map("default_point_reward")
  isActive Boolean @default(true) @map("is_active")
  color     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events Event[]

  @@map("event_types")
}

// ─── Master Data: Seasons ────────────────────────────────────────────────────

model Season {
  id               String   @id @default(cuid())
  name             String // e.g. "Season 1 - Q1 2026", "Season Vassa 2026"
  code             String?  @unique // e.g. "S2026-Q1"
  startDate        DateTime @map("start_date")
  endDate          DateTime @map("end_date")
  isActive         Boolean  @default(false) @map("is_active")
  targetAttendance Int      @default(500) @map("target_attendance")
  bonusPoints      Int      @default(100) @map("bonus_points")
  description      String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  events Event[]

  @@index([isActive, updatedAt(sort: Desc), startDate(sort: Desc)])
  @@index([startDate(sort: Desc), endDate])
  @@map("seasons")
}

// ─── Events ──────────────────────────────────────────────────────────────────

model Event {
  id          String          @id @default(cuid())
  title       String
  description String?
  location    String
  eventDate   DateTime        @map("event_date")
  eventTypeId String?         @map("event_type_id")
  seasonId    String?         @map("season_id")
  status      EventStatus     @default(scheduled)
  visibility  EventVisibility @default(all)
  qrCode      String?         @map("qr_code")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  // Relations
  type        EventType?   @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  season      Season?      @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  attendances Attendance[]

  @@index([status, eventDate])
  @@index([status, visibility])
  @@index([visibility, eventDate])
  @@index([seasonId, eventDate])
  @@index([eventTypeId])
  @@map("events")
}

// ─── Attendances ─────────────────────────────────────────────────────────────

model Attendance {
  id           String           @id @default(cuid())
  userId       String           @map("user_id")
  eventId      String           @map("event_id")
  method       AttendanceMethod @default(qr)
  pointsEarned Int              @default(50) @map("points_earned")
  scannedAt    DateTime         @default(now()) @map("scanned_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId, scannedAt])
  @@index([scannedAt])
  @@index([userId, scannedAt(sort: Desc)])
  @@map("attendances")
}

// ─── Master Data: Point Rules ────────────────────────────────────────────────

model PointRule {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "attendance_rutin", "attendance_special", "streak_bonus"
  label       String
  points      Int      @default(50)
  description String?
  category    String   @default("attendance") // "attendance" | "streak" | "general"
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  transactions PointTransaction[]

  @@map("point_rules")
}

// ─── Point Transactions ──────────────────────────────────────────────────────

model PointTransaction {
  id          String               @id @default(cuid())
  userId      String               @map("user_id")
  ruleId      String?              @map("rule_id")
  amount      Int // e.g. +50, +100, -50
  type        PointTransactionType @default(attendance)
  description String?
  referenceId String?              @map("reference_id") // e.g. attendanceId or eventId
  createdAt   DateTime             @default(now()) @map("created_at")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule PointRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([userId, referenceId, type])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([ruleId])
  @@index([referenceId])
  @@map("point_transactions")
}

