# URL Endpoint Backend API Sekkha (Browser)
# Untuk Local Dev: http://localhost:4000/api
# Untuk Production (lintas domain atau same-domain):
# Gunakan "/api" agar browser hit same-origin ke server Nitro frontend, lalu atur API_PROXY_TARGET di runtime server!
VITE_API_URL=/api

# Runtime Environment untuk Nitro Server Proxy (/api/** -> Backend)
# Isi dengan domain asli backend API (tanpa trailing slash), wajib di-set di environment runtime server frontend production
API_PROXY_TARGET=https://api-sekkha.com
